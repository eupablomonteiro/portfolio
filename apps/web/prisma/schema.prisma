generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id           String   @id @default(uuid())
  slug         String   @unique
  title        String
  description  String
  techs        String[]
  github       String
  live         String?
  coverDesktop String?
  coverMobile  String?
  gallery      String[] @default([])
  mobileGallery String[] @default([])
  displayMode  String   @default("both")
  order        Int      @default(0)
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Experience {
  id        String   @id @default(uuid())
  slug      String   @unique
  company   String
  role      String
  period    String
  location  String
  description String
  techs     String[]
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}